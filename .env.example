# === Reasoning Engine (Groq / Portkey) ===
GROQ_API_KEY=""
GROQ_FALLBACK_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"

# === Portkey LLM Gateway ===
PORTKEY_API_KEY=""

# === Qdrant Vector Database ===
QDRANT_API_KEY=""
